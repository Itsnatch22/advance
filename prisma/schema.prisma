datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Calculation {
  id          String   @id @default(uuid())
  grossPay    Decimal
  netPay      Decimal
  deductions  Json
  country     String?
  city        String?
  ipAddress   String
  device      String?
  createdAt   DateTime @default(now())

  @@map("wage_calculations")
}

model CookieConsent {
  id          String   @id @default(uuid())
  userChoice  String   @map("user_choice")
  categories  Json     @default("{\"necessary\": true, \"analytics\": false}")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("cookie_consents")
}

model NewsletterSubscription {
  id             String    @id @default(uuid())
  email          String    @unique
  status         String    @default("active")
  source         String?
  subscribedAt   DateTime  @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")

  @@map("newsletter_subscriptions")
}

model MeetingLog {
  id              String   @id @default(uuid())
  userEmail       String   @map("user_email")
  adminEmail      String   @map("admin_email")
  meetingType     String   @map("meeting_type")
  calendlyEventId String?  @map("calendly_event_id")
  scheduledAt     DateTime? @map("scheduled_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("meeting_logs")
}

model EmailCampaign {
  id                 String             @id @default(uuid())
  subject            String
  title              String
  htmlContent        String             @map("html_content")
  plainTextContent   String?            @map("plain_text_content")
  status             String             @default("draft")
  createdBy          String             @map("created_by")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  scheduledAt        DateTime?          @map("scheduled_at")
  sentAt             DateTime?          @map("sent_at")
  totalRecipients    Int?               @map("total_recipients")
  sentCount          Int                @default(0) @map("sent_count")
  failedCount        Int                @default(0) @map("failed_count")
  logs               EmailCampaignLog[]

  @@map("email_campaigns")
}

model EmailCampaignLog {
  id                String    @id @default(uuid())
  campaignId        String    @map("campaign_id")
  recipientEmail    String    @map("recipient_email")
  subscriberId      String?   @map("subscriber_id")
  deliveryStatus    String    @default("queued") @map("delivery_status")
  providerMessageId String?   @map("provider_message_id")
  sentAt            DateTime? @map("sent_at")
  openedAt          DateTime? @map("opened_at")
  clickedAt         DateTime? @map("clicked_at")
  errorMessage      String?   @map("error_message")
  createdAt         DateTime  @default(now()) @map("created_at")
  campaign          EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([recipientEmail])
  @@map("email_campaign_logs")
}
